{
  "name": "skill-gauge",
  "version": "0.1.0",
  "description": "LLM Skill/프롬프트를 테스트 케이스로 반복 실행하고 점수·분산·회귀를 측정하는 CLI",
  "type": "module",
  "license": "MIT",
  "bin": {
    "skill-gauge": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "packageManager": "pnpm@11.21.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mck0124/skill-gauge"
  },
  "keywords": [
    "llm",
    "eval",
    "claude-code",
    "skills",
    "cli"
  ]
}
